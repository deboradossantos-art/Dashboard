# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Controle de acesso (Google OAuth via Supabase)
# Opção 1: lista explícita de emails autorizados, separados por vírgula
VITE_ALLOWED_EMAILS=pessoa1@suaorg.org,pessoa2@suaorg.org
# Opção 2: autorizar qualquer email de um domínio inteiro (usada também como
# hint no login do Google). Se VITE_ALLOWED_EMAILS estiver definida, ela tem
# prioridade.
VITE_ALLOWED_EMAIL_DOMAIN=suaorg.org

# Email com permissões de administrador (acessa /historico e itens admin-only)
VITE_ADMIN_EMAIL=admin@suaorg.org

# Sincronização com Google Sheets (opcional — só necessário se for usar
# api/sync-sheets.ts). Ver README para detalhes de configuração.
VITE_SYNC_SECRET=defina-um-segredo-aqui
